NODE_ENV=development
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=mysql://video_factory:change-me@127.0.0.1:3306/video_factory_v5

# Cloudflare Access. Use real values only outside Git.
CLOUDFLARE_AUTH_MODE=remote
CLOUDFLARE_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ADMIN_ACCESS_AUD=
CLOUDFLARE_WORKER_ACCESS_AUD=
ADMIN_ALLOWED_EMAILS=admin@example.com

# Phase 6 scheduling. All persisted scheduledAt values are UTC instants;
# APP_TIMEZONE is the default IANA zone shown/used by Admin forms.
APP_TIMEZONE=America/Mexico_City
SCHEDULER_LEASE_SECONDS=55
SCHEDULER_BATCH_SIZE=50
SCHEDULER_MAX_LATENESS_SECONDS=
SCHEDULE_PAST_TOLERANCE_SECONDS=60
SCHEDULE_MIN_LEAD_SECONDS=

# Phase 5 private Cloudflare R2 storage. Long-lived credentials are server-side only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PRESIGN_TTL_SECONDS=300
R2_SINGLE_UPLOAD_THRESHOLD_BYTES=104857600
R2_MULTIPART_PART_SIZE_BYTES=16777216

# Reserved for later V5 phases. Do not add real values to Git.
APP_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_TOKEN=
