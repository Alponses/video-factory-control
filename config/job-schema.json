{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Factory Job",
  "type": "object",

  "required": [
    "id",
    "slug",
    "title",
    "category",
    "status",
    "createdAt",
    "scenes",
    "renderConfig",
    "render",
    "publishing"
  ],

  "properties": {
    "schemaVersion": {
      "type": "integer"
    },

    "channelId": {
      "type": "string"
    },

    "id": {
      "type": "string"
    },

    "slug": {
      "type": "string"
    },

    "title": {
      "type": "string"
    },

    "category": {
      "type": "string"
    },

    "status": {
      "enum": [
        "pending",
        "processing",
        "approved",
        "failed",
        "published"
      ]
    },

    "createdAt": {
      "type": "string"
    },

    "scenes": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,

      "items": {
        "type": "object",
        "required": [
          "text",
          "searchTerms"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "searchTerms": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },

    "renderConfig": {
      "type": "object"
    },

    "render": {
      "type": "object"
    },

    "publishing": {
      "type": "object",
      "properties": {
        "tiktok": {
          "type": "object",
          "properties": {
            "profileId": { "type": ["string", "null"] },
            "status": { "type": "string" },
            "caption": { "type": ["string", "null"] },
            "hashtags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "coverText": { "type": ["string", "null"] },
            "pinnedComment": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] },
            "publishedAt": { "type": ["string", "null"] }
          }
        },

        "youtube": {
          "type": "object",
          "properties": {
            "profileId": { "type": ["string", "null"] },
            "status": { "type": "string" },
            "title": { "type": ["string", "null"] },
            "description": { "type": ["string", "null"] },
            "hashtags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "coverText": { "type": ["string", "null"] },
            "pinnedComment": { "type": ["string", "null"] },
            "videoId": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] },
            "publishedAt": { "type": ["string", "null"] }
          }
        },

        "facebook": {
          "type": "object",
          "properties": {
            "profileId": { "type": ["string", "null"] },
            "status": { "type": "string" },
            "description": { "type": ["string", "null"] },
            "hashtags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "coverText": { "type": ["string", "null"] },
            "pinnedComment": { "type": ["string", "null"] },
            "postId": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] },
            "publishedAt": { "type": ["string", "null"] }
          }
        }
      }
    },

    "analytics": {
      "type": "object"
    }
  }
}
