VIDEO_FACTORY_URL=https://factory.norvian.io
WORKER_ID=imac-01
WORKER_SECRET=

CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Local cryptographic demo only: a correctly signed worker-audience Access JWT.
CF_ACCESS_JWT_ASSERTION=

RENDERER_URL=http://127.0.0.1:3123
HEARTBEAT_INTERVAL_MS=20000
CLAIM_INTERVAL_MS=15000
LEASE_RENEW_INTERVAL_MS=30000
API_TIMEOUT_MS=10000
RENDERER_TIMEOUT_MS=10000
RENDERER_POLL_INTERVAL_MS=2000
OUTPUT_DIR=./output

# Phase 5 direct durable upload behavior. Workers NEVER receive permanent R2 credentials.
R2_UPLOAD_MAX_RETRIES=3
DELETE_LOCAL_AFTER_DURABLE_UPLOAD=false
